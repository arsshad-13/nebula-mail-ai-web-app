# Google OAuth 2.0 Credentials
# Obtain these from the Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect URI
# Must match one of the Authorized redirect URIs configured in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter AI Provider (Stage 4)
# Obtain from OpenRouter dashboard: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
AI_MODEL=openrouter/free

# Google Cloud Pub/Sub & Real-Time Sync (Stage 4F)
# Topic format: projects/{PROJECT_ID}/topics/{TOPIC_NAME}
PUBSUB_TOPIC_NAME=projects/your-project-id/topics/your-topic-name
# Shared secret token for validating incoming Pub/Sub push webhook requests
PUBSUB_WEBHOOK_SECRET=your-random-webhook-secret-token
